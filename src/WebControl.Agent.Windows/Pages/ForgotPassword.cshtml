@page "/forgot-password"
@model WebControl.Agent.Windows.Pages.ForgotPasswordModel

@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <div class="text-center mb-4">
                    <h2 class="mb-1">WebControl</h2>

                    <div class="text-muted">
                        Recuperar contraseña
                    </div>
                </div>

                @if (Model.Success)
                {
                    <div class="alert alert-success">
                        La contraseña fue cambiada correctamente.
                    </div>

                    <div class="alert alert-warning">
                        <strong>Guarde su nuevo código de recuperación.</strong>

                        <div class="mt-3">
                            <code class="fs-5">
                                @Model.NewRecoveryCode
                            </code>
                        </div>

                        <div class="small mt-3">
                            El código anterior ya no es válido.
                            WebControl no conserva este nuevo código en texto plano.
                        </div>
                    </div>

                    <a href="/login"
                       class="btn btn-primary w-100">
                        Volver a iniciar sesión
                    </a>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @Model.ErrorMessage
                        </div>
                    }

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Username"
                                   class="form-label">
                                Usuario
                            </label>

                            <input asp-for="Input.Username"
                                   class="form-control"
                                   autocomplete="username"
                                   autofocus />

                            <span asp-validation-for="Input.Username"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.RecoveryCode"
                                   class="form-label">
                                Código de recuperación
                            </label>

                            <input asp-for="Input.RecoveryCode"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="XXXX-XXXX-XXXX-XXXX-XXXX" />

                            <span asp-validation-for="Input.RecoveryCode"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.NewPassword"
                                   class="form-label">
                                Nueva contraseña
                            </label>

                            <input asp-for="Input.NewPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Input.NewPassword"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label">
                                Confirmar nueva contraseña
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Cambiar contraseña
                        </button>

                    </form>

                    <div class="text-center mt-4">
                        <a href="/login"
                           class="text-decoration-none">
                            Volver al inicio de sesión
                        </a>
                    </div>
                }

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
