@page "/login"
@model WebControl.Agent.Windows.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <div class="text-center mb-4">
                    <h2 class="mb-1">WebControl</h2>
                    <div class="text-muted">
                        Administración
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Username"
                               class="form-label">
                            Usuario
                        </label>

                        <input asp-for="Input.Username"
                               class="form-control"
                               autocomplete="username"
                               autofocus />

                        <span asp-validation-for="Input.Username"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password"
                               class="form-label">
                            Contraseña
                        </label>

                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="current-password" />

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Input.RememberMe"
                               class="form-check-input" />

                        <label asp-for="Input.RememberMe"
                               class="form-check-label">
                            Recordarme en este dispositivo
                        </label>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Iniciar sesión
                    </button>

                </form>

                <div class="text-center mt-4">
                    <a href="#"
                       class="text-decoration-none disabled"
                       aria-disabled="true">
                        ¿Olvidó su contraseña?
                    </a>

                    <div class="small text-muted mt-1">
                        Recuperación disponible próximamente.
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
